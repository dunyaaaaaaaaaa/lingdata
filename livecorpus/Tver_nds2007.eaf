                <ANNOTATION_VALUE>в общем масштаб только пугает</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts14">
