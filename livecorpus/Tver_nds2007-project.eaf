    <TIER ANNOTATOR="asp2007f" LINGUISTIC_TYPE_REF="default-lt" TIER_ID="comment">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347"
                TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>с "кринжами" как и с "ок" (ближе к концу минуты будет) странно... имеется в виду существительное (кринжы=одноклассники), но это опять же заимствование... еще из-за того, что это заимвствование я нагло решила писать "кринжЫ" невзирая на правила русского языка (извините,оно так логичнее выглядит... как по мне)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345"
                TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts307">
                <ANNOTATION_VALUE>"ок" в русском ощущается как наречие (как? ок), но это же не русское слово))) так что либо adverb, либо Х (как заимствование)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346"
                TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>писала раннее</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
