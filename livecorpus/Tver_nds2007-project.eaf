        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@asp2007f" PARTICIPANT="asp2007f" TIER_ID="gestComment@asp2007f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2777"
                TIME_SLOT_REF1="ts768" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>я думаю, что  здесь изобразительный, а не прагматический, потому что жест, который я делаю - это пародирование ауф (волки, "крутые" цитаты вк и тд...), который обозначает крутость, но, возможно,если смотреть с точки зрения не зумера,то это как номер 1? или что-то просто обозначающее все равно крутость, но скорее как прагматический жест</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
